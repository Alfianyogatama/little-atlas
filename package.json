{
  "name": "little-atlas",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "vite",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "prebuild": "bun run i18n:compile",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "pretypecheck": "bun run i18n:compile",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.domain.json --noEmit",
    "prelint": "bun run i18n:compile",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "bun run i18n:compile",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content": "bun scripts/build-content.ts",
    "icons:generate": "bun scripts/icons/generate-cli.ts",
    "icons:reprocess": "bun scripts/icons/reprocess-cli.ts",
    "icons:review": "bun scripts/icons/review-server.ts",
    "content:check": "bun scripts/check-content.ts",
    "check:bundle": "bun scripts/check-bundle-size.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.0",
    "@types/polylabel": "2.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.1.1",
    "cldr-localenames-modern": "45.0.0",
    "d3-geo": "3.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "flag-icons": "7.5.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "polylabel": "2.1.0",
    "prettier": "3.9.9",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "world-atlas": "2.0.2"
  }
}
